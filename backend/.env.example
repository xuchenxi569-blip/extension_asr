# 服务端口
PORT=8787

# mock = 假识别，只用来测通路
# openai-compatible = 真识别（OpenAI / Groq / 硅基流动等同一套接口）
ASR_PROVIDER=mock

# 真识别时必填。密钥只写在本机这份 .env 里，不要提交到 Git。
# ASR_API_KEY=replace-with-your-key
# ASR_BASE_URL=https://api.openai.com
# ASR_MODEL=whisper-1
# ASR_LANGUAGE=zh
# ASR_CHUNK_MS=5000
# ASR_TIMEOUT_MS=25000
