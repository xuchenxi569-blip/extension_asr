{
  "manifest_version": 3,
  "name": "Extension ASR",
  "version": "0.5.1",
  "minimum_chrome_version": "116",
  "description": "网页视频字幕与语音转写：优先原生字幕，无字幕时听标签页声音转写",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "Extension ASR - 打开转写侧边栏",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "tabCapture",
    "offscreen",
    "sidePanel",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "type": "module",
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["offscreen/pcm-processor.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
